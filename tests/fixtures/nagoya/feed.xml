<figure class="wp-block-image size-large is-resized"><img loading="lazy" decoding="async" width="1024" height="576" src="https://nagoyakeirin.com/wp-content/uploads/2026/09/1-1-1024x576.png" alt="" class="wp-image-47285" style="aspect-ratio:1.7777808691781203;width:760px;height:auto" srcset="https://nagoyakeirin.com/wp-content/uploads/2026/09/1-1-1024x576.png 1024w, https://nagoyakeirin.com/wp-content/uploads/2026/09/1-1-300x169.png 300w, https://nagoyakeirin.com/wp-content/uploads/2026/09/1-1-768x432.png 768w, https://nagoyakeirin.com/wp-content/uploads/2026/09/1-1-1536x864.png 1536w, https://nagoyakeirin.com/wp-content/uploads/2026/09/1-1-320x180.png 320w, https://nagoyakeirin.com/wp-content/uploads/2026/09/1-1.png 1920w" sizes="auto, (max-width: 1024px) 100vw, 1024px" /></figure>



